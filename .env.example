# Copy to .env and replace secrets before non-local use.
# Switch to real VeriFayda / CBS later by changing URLs + keys only.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ekyc_db
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars-long!!
HMAC_SALT_KEY=change-me-hmac-salt-min-32-chars-long!!
AES_MASTER_KEY=01234567890123456789012345678901

FAYDA_API_KEY=dev-fayda-key
FAYDA_SANDBOX_URL=http://fayda-sandbox:8081/fayda/v2

BANK_API_KEY=dev-bank-key
BANK_CBS_SANDBOX_URL=http://cbs-sandbox:8082/cbs/v1

# Optional ONNX model paths (drop files in; no code change required)
# LIVENESS_MODEL_PATH=/models/silent_face_anti_spoofing.onnx
# FACE_MATCH_MODEL_PATH=/models/facenet.onnx

CLEANUP_INTERVAL_SECONDS=60
API_PUBLIC_HOST=0.0.0.0
